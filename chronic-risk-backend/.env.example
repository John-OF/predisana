# Variables de entorno del backend (plantilla — copia los valores a tu shell o al
# panel de variables del hosting). NOTA: la app las lee del ENTORNO; no carga
# este archivo automaticamente (no hay python-dotenv).
#
# PowerShell (dev):
#   $env:ADMIN_TOKEN = "una-clave-secreta"; python app.py

# Token del panel /admin (dev-only). Sin el, todos los /admin/* responden 503.
# No es auth de usuario: las simulaciones son anonimas y nadie se loguea.
ADMIN_TOKEN=cambia-esta-clave

# Base de datos. Por defecto SQLite en el propio directorio del backend.
# En produccion, Postgres (el disco efimero del hosting borraria el .db):
#   DATABASE_URL=postgresql+psycopg2://usuario:clave@host:5432/predisana
DATABASE_URL=sqlite:///medical_history.db

# Debugger interactivo de Werkzeug: NUNCA en produccion (permite ejecutar codigo
# desde el navegador si se filtra el PIN). Solo en local y a proposito.
FLASK_DEBUG=0

# --- CORS (AUD-4) ---
# Origenes permitidos en los endpoints publicos. Vacio = abierto a todos ("*"),
# comodo en dev; en produccion, el dominio del front:
#   CORS_ORIGINS=https://predisana.vercel.app
CORS_ORIGINS=

# Origenes permitidos en /admin/*. NUNCA hereda el "*" de arriba: si no se define,
# solo valen los origenes de desarrollo (localhost:5173 y :4173). Si el panel admin
# se abre desde el dominio desplegado, hay que listarlo aqui o devolvera 403.
ADMIN_CORS_ORIGINS=

# --- Rate limiting (AUD-4) ---
# Cubetas por IP. Los valores por defecto ya son razonables; se sobreescriben solo
# si el trafico real lo pide. /health esta exento (monitores de uptime).
RATE_LIMIT_DEFAULT=300 per minute
RATE_LIMIT_PREDICT=60 per minute
RATE_LIMIT_ADMIN=60 per minute
RATE_LIMIT_ADMIN_VERIFY=10 per minute
# Almacenamiento de las cubetas. "memory://" es por proceso: con varios workers de
# gunicorn cada uno lleva su cuenta (el limite efectivo se multiplica). Con Redis:
#   RATE_LIMIT_STORAGE=redis://host:6379
RATE_LIMIT_STORAGE=memory://

# Confiar en X-Forwarded-For para identificar la IP del cliente. Activar SOLO si hay
# un proxy delante (Render, Fly, Nginx): sin proxy, cualquiera falsea la cabecera y
# se salta el limite. Sin esto, detras de un proxy TODOS comparten la misma cubeta.
TRUST_PROXY_HEADERS=0
