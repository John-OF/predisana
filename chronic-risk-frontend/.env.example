# Variables de entorno del frontend (Vite). Copia este archivo a `.env.local`
# y ajusta el valor; Vite lo carga automaticamente y `.env.local` esta gitignored.
#
# URL del backend. Si se omite, src/services/api.js cae a http://localhost:8000.
# En el deploy debe apuntar al dominio publico del API (con https).
VITE_API_URL=http://localhost:8000
